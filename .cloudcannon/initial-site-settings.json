{
  "ssg": "astro",
  "build_configuration": {
    "preserved_paths": "node_modules/",
    "environment_variables": [
      { 
        "key": "CLOUDCANNON_CONFIG_PATH",
        "value": ".cloudcannon/cloudcannon.config.yml" 
      }
    ],
    "install_command": "pnpm i",
    "build_command": "pnpm build",
    "output_path": "dist"
  }
}
