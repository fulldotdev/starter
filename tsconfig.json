{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "noErrorTruncation": true,
    "baseUrl": ".",
    "paths": {
      "@blocks/*": [
        "src/blocks/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@schemas/*": [
        "src/schemas/*"
      ]
    }
  }
}