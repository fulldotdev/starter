---
import { Heading } from 'fulldev-ui'

const {
  structure = 'column',
  size = 'lg',
  variant = 'subtle',
  align = 'center',
  level = 2,
  badge,
  tagline,
  heading,
  text,
  buttons,
  frame = 'panel',
  input,
  ...rest
} = Astro.props
---

<section {...rest}>
  <div>
    <Heading>{heading}</Heading>
  </div>
</section>
