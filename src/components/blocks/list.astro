---
interface Props {
  items: string[]
  title: string
}

const { items, title } = Astro.props
---

<div class="space-y-4">
  <p class="text-muted-foreground text-xs font-medium uppercase tracking-[0.15em]">
    {title}
  </p>
  <ul class="space-y-3 text-sm leading-relaxed">
    {
      items.map((item) => (
        <li class="text-muted-foreground flex gap-3">
          <span class="text-primary/40 mt-0.5 shrink-0">&mdash;</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</div>
