---
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Logo } from "@/components/ui/logo"
import { LogoText } from "@/components/ui/logo"
import { ThemeToggle } from "@/components/ui/theme-toggle"

interface NavItem {
  text?: string
  href?: string
  icon?: string
  target?: string
  children?: {
    text?: string
    href?: string
    icon?: string
    target?: string
  }[]
}

interface Props {
  logo?: {
    src?: any
    alt?: string
    text?: string
    href?: string
  }
  nav?: NavItem[]
}

const { logo, nav } = Astro.props
const currentPath = Astro.url.pathname
---

<header
  class="bg-background/80 border-border/40 sticky top-0 z-50 w-full border-b backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-16 max-w-(--breakpoint-xl) items-center justify-between px-6"
  >
    <!-- Logo -->
    <a
      href={logo?.href || "/"}
      class="text-foreground flex items-center gap-2.5 text-base font-semibold tracking-tight"
    >
      {logo?.text}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {
        nav?.map((item) => (
          <a
            href={item.href}
            target={item.target}
            class:list={[
              "text-muted-foreground hover:text-foreground relative px-3 py-2 text-sm font-medium transition-colors",
              currentPath === item.href &&
                "text-foreground after:bg-primary after:absolute after:bottom-0 after:left-3 after:right-3 after:h-0.5 after:rounded-full",
            ]}
          >
            {item.icon && <Icon name={item.icon} />}
            {item.text}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <ThemeToggle />

      <!-- Mobile Menu Toggle -->
      <button
        class="hover:bg-accent inline-flex size-9 items-center justify-center rounded-md md:hidden"
        aria-label="Toggle menu"
        data-mobile-toggle
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div
    class="border-border/40 hidden border-t md:hidden"
    data-mobile-menu
  >
    <nav class="flex flex-col px-6 py-4" aria-label="Mobile navigation">
      {
        nav?.map((item) => (
          <a
            href={item.href}
            target={item.target}
            class:list={[
              "text-muted-foreground hover:text-foreground border-border/40 border-b py-3 text-sm font-medium transition-colors last:border-0",
              currentPath === item.href && "text-foreground",
            ]}
          >
            {item.icon && <Icon name={item.icon} />}
            {item.text}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-mobile-toggle]")
  const menu = document.querySelector("[data-mobile-menu]")
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden")
  })
</script>
