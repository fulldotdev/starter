---
import Layers3Icon from "lucide-static/icons/layers-3.svg"
import OrbitIcon from "lucide-static/icons/orbit.svg"
import SparklesIcon from "lucide-static/icons/sparkles.svg"
import WorkflowIcon from "lucide-static/icons/workflow.svg"

interface FeatureItem {
  title: string
  description: string
}

interface Props {
  eyebrow?: string
  title?: string
  items: FeatureItem[]
  layout?: "grid" | "stack"
}

const { eyebrow, title, items, layout = "stack" } = Astro.props
const icons = [Layers3Icon, OrbitIcon, WorkflowIcon, SparklesIcon]
---

<section class="space-y-12">
  {
    (eyebrow || title) && (
      <div class="mx-auto max-w-2xl text-center">
        {eyebrow && (
          <p class="text-muted-foreground mb-3 text-xs font-medium uppercase tracking-[0.2em]">
            {eyebrow}
          </p>
        )}
        {title && (
          <h2 class="text-2xl font-medium tracking-tight sm:text-3xl">
            {title}
          </h2>
        )}
      </div>
    )
  }

  <div class:list={[layout === "grid" ? "grid gap-6 sm:grid-cols-2 lg:grid-cols-3" : "space-y-4"]}>
    {
      items.map((item, index) => {
        const Icon = icons[index % icons.length]

        return (
        <div
          class:list={[
            layout === "grid"
              ? "bg-card/70 border-border/50 rounded-xl border p-6 shadow-sm"
              : "bg-card border-border/50 rounded-xl border p-5",
            layout === "grid" ? "space-y-4" : "flex gap-4",
          ]}
        >
          <div class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-lg">
            <Icon class="size-4" />
          </div>
          <div class="space-y-1.5">
            <h2 class="text-sm font-medium">{item.title}</h2>
            {
              item.description && (
                <p class="text-muted-foreground text-sm leading-relaxed">
                  {item.description}
                </p>
              )
            }
          </div>
        </div>
      )
      })
    }
  </div>
</section>
