---
import type { ComponentProps } from 'astro/types'
import { Heading, Image, Row, Section, Text } from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  heading?: string
  text?: string
  logos?: string[]
}

const { logos, heading, text, ...rest } = Astro.props
---

<Section
  structure="spread"
  {...rest}
>
  <Heading html={heading} />
  <Text html={text} />
  {
    logos?.map((logo) => (
      <Row>
        <Image src={logo} />
      </Row>
    ))
  }
</Section>
