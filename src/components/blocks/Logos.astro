---
import type { ComponentProps } from 'astro/types'
import { Heading, Image, Row, Section, Spread, Text } from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  heading?: string
  text?: string
  logos?: string[]
}

const { logos, heading, text, ...rest } = Astro.props
---

<Section
  structure="column"
  {...rest}
>
  <Heading html={heading} />
  <Text html={text} />
  <Spread>
    {
      logos?.map((logo) => (
        <Row>
          <Image src={logo} />
        </Row>
      ))
    }
    <Spread />
  </Spread>
</Section>
