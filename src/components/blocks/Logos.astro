---
import type { ComponentProps } from 'astro/types'
import { Heading, Image, Section, Text, Wrap } from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  heading?: string
  text?: string
  logos?: string[]
}

const { logos, heading, text, ...rest } = Astro.props
---

<Section
  align="center"
  {...rest}
>
  <Heading html={heading} />
  <Text html={text} />
  <Wrap
    align="center"
    style={{ justifyContent: 'center' }}
  >
    {
      logos?.map((logo) => (
        <Image
          style={{ maxWidth: '200px' }}
          src={logo}
        />
      ))
    }
  </Wrap>
</Section>
