---
import { Icon } from "@/components/ui/icon"
import { Separator } from "@/components/ui/separator"

interface Props {
  logo?: {
    src?: any
    alt?: string
    text?: string
    href?: string
  }
  description?: string
  columns?: {
    title: string
    links: {
      text?: string
      href?: string
      icon?: string
      target?: string
    }[]
  }[]
  socials?: {
    platform?: string
    href?: string
    icon?: string
  }[]
  bottomText?: string
}

const { logo, description, columns, socials, bottomText } = Astro.props
---

<footer class="bg-background border-border/40 border-t">
  <div
    class="mx-auto max-w-(--breakpoint-xl) px-6 pt-16 pb-8"
  >
    <!-- Top: Logo + Columns Grid -->
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1.5fr_repeat(auto-fit,1fr)] lg:gap-16">
      <!-- Brand Column -->
      <div class="flex max-w-sm flex-col gap-4">
        {
          logo && (
            <a
              href={logo.href || "/"}
              class="text-foreground text-base font-semibold tracking-tight"
            >
              {logo.text}
            </a>
          )
        }
        {
          description && (
            <p class="text-muted-foreground text-sm leading-relaxed">
              {description}
            </p>
          )
        }
        {
          socials && socials.length > 0 && (
            <div class="mt-2 flex gap-3">
              {socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  aria-label={social.platform}
                >
                  <Icon name={social.icon} href={social.href} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <!-- Link Columns -->
      {
        columns?.map((column) => (
          <div class="flex flex-col gap-4">
            <h3 class="text-foreground text-sm font-semibold tracking-wide">
              {column.title}
            </h3>
            <nav class="flex flex-col gap-2.5" aria-label={column.title}>
              {column.links.map((link) => (
                <a
                  href={link.href}
                  target={link.target}
                  class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                >
                  {link.icon && <Icon name={link.icon} />}
                  {link.text}
                </a>
              ))}
            </nav>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    {
      bottomText && (
        <>
          <div class="bg-border/40 my-8 h-px" />
          <p class="text-muted-foreground text-xs">{bottomText}</p>
        </>
      )
    }
  </div>
</footer>
