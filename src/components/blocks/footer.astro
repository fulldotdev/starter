---
import { Image as AstroImage } from "astro:assets"

import { Container } from "@/components/ui/container"
import { Icon } from "@/components/ui/icon"

interface LinkItem {
  label: string
  href: string
}

interface ContactItem {
  label: string
  value: string
  href?: string
}

interface Logo {
  src: ImageMetadata
  alt: string
}

interface Props {
  contact: ContactItem[]
  logo: Logo
  navigation: LinkItem[]
  siteName: string
  social: LinkItem[]
  tagline: string
}

const { contact, logo, navigation, siteName, social, tagline } = Astro.props
---

<footer class="bg-secondary/20 border-border/50 mt-auto border-t">
  <Container class="py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)_minmax(0,0.8fr)]">
      <div class="space-y-5">
        <div class="flex items-center gap-2.5">
          <AstroImage
            src={logo.src}
            alt=""
            aria-hidden="true"
            class="h-7 w-auto"
            widths={[56]}
            sizes="28px"
          />
          <span class="text-lg font-semibold tracking-tight">{siteName}</span>
        </div>
        <p class="text-muted-foreground max-w-sm text-sm leading-relaxed">
          {tagline}
        </p>
      </div>

      <div class="grid gap-12 sm:grid-cols-2 md:col-span-2 md:grid-cols-3">
        <div class="space-y-4">
          <p class="text-muted-foreground text-xs font-medium uppercase tracking-[0.15em]">
            Navigation
          </p>
          <nav class="flex flex-col gap-2.5 text-sm">
            {
              navigation.map((link) => (
                <a
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  href={link.href}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="space-y-4">
          <p class="text-muted-foreground text-xs font-medium uppercase tracking-[0.15em]">
            Contact
          </p>
          <nav class="flex flex-col gap-2.5 text-sm">
            {
              contact
                .filter((item) => item.href)
                .map((item) => (
                  <a
                    class="text-muted-foreground hover:text-foreground transition-colors"
                    href={item.href}
                  >
                    {item.value}
                  </a>
                ))
            }
          </nav>
        </div>

        {
          social.length > 0 && (
            <div class="space-y-4">
              <p class="text-muted-foreground text-xs font-medium uppercase tracking-[0.15em]">
                Social
              </p>
              <nav class="flex flex-col gap-2.5 text-sm">
                {social.map((link) => (
                  <a
                    class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 transition-colors"
                    href={link.href}
                  >
                    <Icon href={link.href} class="size-4" />
                    {link.label}
                  </a>
                ))}
              </nav>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</footer>
