---
import Button from "@/components/ui/button/button.astro"
import {
  Field,
  FieldContent,
  FieldDescription,
  FieldGroup,
  FieldLabel,
  FieldLegend,
  FieldSet,
} from "@/components/ui/field"
import Input from "@/components/ui/input/input.astro"
import Textarea from "@/components/ui/textarea/textarea.astro"
---

<section class="bg-card border-border/50 rounded-xl border p-6 shadow-sm sm:p-8">
  <div class="mb-6 space-y-2">
    <p class="text-muted-foreground text-xs font-medium uppercase tracking-[0.15em]">
      Contact form
    </p>
    <h2 class="text-xl font-medium tracking-tight">Send a project inquiry</h2>
    <p class="text-muted-foreground text-sm leading-relaxed">
      This is a plain example form built with the shared field primitives.
    </p>
  </div>

  <form class="space-y-6" action="#" method="post">
    <FieldSet>
      <FieldLegend class="sr-only">Project inquiry</FieldLegend>
      <FieldGroup>
        <Field>
          <FieldLabel for="contact-name">Name</FieldLabel>
          <FieldContent>
            <Input
              id="contact-name"
              name="name"
              placeholder="Jane Doe"
              type="text"
            />
            <FieldDescription>Use the name you want us to reply to.</FieldDescription>
          </FieldContent>
        </Field>

        <Field>
          <FieldLabel for="contact-email">Email</FieldLabel>
          <FieldContent>
            <Input
              id="contact-email"
              name="email"
              placeholder="jane@company.com"
              type="email"
            />
          </FieldContent>
        </Field>

        <Field>
          <FieldLabel for="contact-company">Company</FieldLabel>
          <FieldContent>
            <Input
              id="contact-company"
              name="company"
              placeholder="Fulldev"
              type="text"
            />
          </FieldContent>
        </Field>

        <Field>
          <FieldLabel for="contact-message">Project details</FieldLabel>
          <FieldContent>
            <Textarea
              id="contact-message"
              name="message"
              placeholder="Tell us what you are building, what stage you are in, and what kind of help you need."
              rows={6}
            />
            <FieldDescription>
              A short scope, timeline, and links to existing work are enough.
            </FieldDescription>
          </FieldContent>
        </Field>
      </FieldGroup>
    </FieldSet>

    <Button size="lg" type="submit">Send inquiry</Button>
  </form>
</section>
