---
import type { ComponentProps } from 'astro/types'
import { Heading, Row, Section, Spread, Text } from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  heading?: string
  text?: string
  stats?: { heading: string; text: string }[]
}

const { heading, text, stats, ...rest } = Astro.props
---

<Section
  structure="column"
  {...rest}
>
  <Heading html={heading} />
  <Text html={text} />
  <Spread>
    {
      stats?.map((stat) => (
        <Row>
          <Heading
            level={3}
            html={stat.heading}
          />
          <Text html={stat.text} />
        </Row>
      ))
    }
  </Spread>
</Section>
