---
import type { GlobalSchema } from "@/schemas/global"
import type { AboutSchema } from "@/schemas/layouts/about"
import Features from "@/components/blocks/features.astro"
import Intro from "@/components/blocks/intro.astro"
import Article from "@/components/blocks/article.astro"
import { Container } from "@/components/ui/container"
import BaseLayout from "@/components/layouts/base.astro"

interface Props {
  page: AboutSchema
  global: GlobalSchema
}

const { page, global } = Astro.props
const principleItems = page.principles.map((principle) => ({
  title: principle,
  description: "",
}))
---

<BaseLayout global={global} page={page}>
  <Container class="space-y-20">
    <Intro data={page.intro} />
    <Features items={principleItems} layout="grid" title="Principles" />
    <Features items={page.milestones} layout="grid" title="How the starter is wired" />
    <Article>
      <slot />
    </Article>
  </Container>
</BaseLayout>
