---
import type { GlobalSchema } from "@/schemas/global"
import type { HomeSchema } from "@/schemas/layouts/home"
import Cta from "@/components/blocks/cta.astro"
import Features from "@/components/blocks/features.astro"
import Hero from "@/components/blocks/hero.astro"
import { Container } from "@/components/ui/container"
import BaseLayout from "@/components/layouts/base.astro"

interface Props {
  page: HomeSchema
  global: GlobalSchema
}

const { page, global } = Astro.props
---

<BaseLayout global={global} page={page}>
  <Container class="space-y-20">
    <Hero data={page.hero} />
    <Features
      items={page.features}
      layout="grid"
    />
    <Cta
      title={page.ctaPanel.title}
      description={page.ctaPanel.description}
      cta={page.ctaPanel.cta}
    />
  </Container>
</BaseLayout>
