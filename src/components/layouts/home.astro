---
import type { HomeSchema } from "@/schemas/layouts/home"

import Footer from "@/components/blocks/footer.astro"
import Header from "@/components/blocks/header.astro"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Image } from "@/components/ui/image"
import { Layout, LayoutHead, LayoutBody, LayoutMain } from "@/components/ui/layout"
import {
  Section,
  SectionActions,
  SectionContent,
  SectionGrid,
  SectionMedia,
  SectionProse,
} from "@/components/ui/section"
import {
  Tile,
  TileContent,
  TileDescription,
  TileMedia,
  TileTitle,
} from "@/components/ui/tile"

interface Props extends HomeSchema {}

const { title, description, hero, features, testimonials, cta } = Astro.props
const global = Astro.locals.global
---

<Layout>
  <LayoutHead title={title} description={description} />
  <LayoutBody>
    {global?.header && <Header {...global.header} />}
    <LayoutMain>
      {/* Hero */}
      <Section size="lg">
        <SectionContent class="items-center text-center">
          <SectionProse size="lg" class="text-balance">
            <h1 set:html={hero.title} />
            <p class="text-muted-foreground text-lg" set:html={hero.description} />
          </SectionProse>
          <SectionActions class="justify-center">
            {hero.links.map(({ icon, text, ...link }, i) => (
              <Button variant={i === 0 ? "default" : "outline"} size="lg" {...link}>
                {icon && <Icon name={icon} />}
                {text}
              </Button>
            ))}
          </SectionActions>
        </SectionContent>
        {hero.image?.src && (
          <SectionMedia>
            <Image sizes="(min-width: 1536px) 1536px, 100vw" {...hero.image} />
          </SectionMedia>
        )}
      </Section>

      <slot />

      {/* Features */}
      <Section>
        <SectionContent class="items-center text-center">
          <SectionProse>
            <h2 set:html={features.title} />
            <p class="text-muted-foreground" set:html={features.description} />
          </SectionProse>
        </SectionContent>
        <SectionGrid>
          {features.items.map((item) => (
            <Tile>
              {item.icon && (
                <TileMedia variant="icon">
                  <Icon name={item.icon} />
                </TileMedia>
              )}
              <TileContent>
                <TileTitle>{item.title}</TileTitle>
                <TileDescription>{item.description}</TileDescription>
              </TileContent>
            </Tile>
          ))}
        </SectionGrid>
      </Section>

      {/* Testimonials */}
      <Section>
        <SectionContent class="items-center text-center">
          <SectionProse>
            <h2 set:html={testimonials.title} />
            <p class="text-muted-foreground" set:html={testimonials.description} />
          </SectionProse>
        </SectionContent>
        <SectionGrid>
          {testimonials.items.map((item) => (
            <div class="bg-card border-border/50 flex flex-col gap-4 rounded-xl border p-6">
              {item.rating && (
                <div class="flex gap-0.5">
                  {Array.from({ length: item.rating }).map(() => (
                    <Icon name="star" class="text-amber-400 size-4 fill-current" />
                  ))}
                </div>
              )}
              <blockquote class="text-foreground text-sm leading-relaxed">
                &ldquo;{item.quote}&rdquo;
              </blockquote>
              <div class="mt-auto flex items-center gap-3 pt-2">
                <div class="flex flex-col">
                  <span class="text-foreground text-sm font-semibold">{item.author}</span>
                  {(item.role || item.company) && (
                    <span class="text-muted-foreground text-xs">
                      {[item.role, item.company].filter(Boolean).join(", ")}
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </SectionGrid>
      </Section>

      {/* CTA */}
      <Section variant="floating">
        <SectionContent class="items-center text-center">
          <SectionProse>
            <h2 set:html={cta.title} />
            <p class="text-muted-foreground" set:html={cta.description} />
          </SectionProse>
          <SectionActions class="justify-center">
            {cta.links.map(({ icon, text, ...link }, i) => (
              <Button variant={i === 0 ? "default" : "outline"} size="lg" {...link}>
                {icon && <Icon name={icon} />}
                {text}
              </Button>
            ))}
          </SectionActions>
        </SectionContent>
      </Section>
    </LayoutMain>
    {global?.footer && <Footer {...global.footer} />}
  </LayoutBody>
</Layout>
