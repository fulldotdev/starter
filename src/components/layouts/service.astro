---
import type { GlobalSchema } from "@/schemas/global"
import type { ServiceSchema } from "@/schemas/layouts/service"
import Features from "@/components/blocks/features.astro"
import Intro from "@/components/blocks/intro.astro"
import Article from "@/components/blocks/article.astro"
import { Container } from "@/components/ui/container"
import BaseLayout from "@/components/layouts/base.astro"

interface Props {
  page: ServiceSchema
  global: GlobalSchema
}

const { page, global } = Astro.props
const deliverableItems = page.deliverables.map((deliverable) => ({
  title: deliverable,
  description: "",
}))
---

<BaseLayout global={global} page={page}>
  <Container class="space-y-20">
    <Intro data={page.summary} />
    <Features items={deliverableItems} layout="grid" title="Deliverables" />
    <Features items={page.process} layout="grid" title="Typical engagement flow" />
    <Article>
      <slot />
    </Article>
  </Container>
</BaseLayout>
