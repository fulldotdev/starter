---
import { getCollection, getEntry, render } from "astro:content"

import Layout from "@/components/layouts/base.astro"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  return pages.map((page) => {
    return {
      params: {
        page: page.id === "index" ? undefined : page.id,
      },
      props: page,
    }
  })
}

const page = Astro.props
const { Content } = await render(Astro.props)

const baseLayout = await getEntry("layouts", "base")
const pageLayout = await getEntry("layouts", page.data?.layout)
---

<Layout
  {...baseLayout?.data}
  {...pageLayout?.data}
  {...page.data}
  sections={[
    ...(page.data.sections ?? []),
    ...(pageLayout?.data.sections ?? []),
    ...(baseLayout?.data.sections ?? []),
  ]}
>
  <Content />
</Layout>
