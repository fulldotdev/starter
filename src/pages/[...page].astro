---
import { i18n } from "astro:config/server"
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content"

import AboutLayout from "@/components/layouts/about.astro"
import ContactLayout from "@/components/layouts/contact.astro"
import HomeLayout from "@/components/layouts/home.astro"
import LandingLayout from "@/components/layouts/landing.astro"
import ServiceLayout from "@/components/layouts/service.astro"

type PageEntry = CollectionEntry<"pages">

interface Props extends PageEntry {}

function resolveGlobalId(locale?: string) {
  const defaultLocale = i18n?.defaultLocale ?? "en"
  const currentLocale = locale ?? defaultLocale

  return currentLocale === defaultLocale ? "index" : currentLocale
}

export async function getStaticPaths() {
  const pages = await getCollection("pages")

  return pages.map((page) => {
    const slug = page.data.slug?.replace(/^\/+|\/+$/g, "")

    return {
      params: { page: slug || (page.id === "index" ? undefined : page.id) },
      props: page,
    }
  })
}

const page = Astro.props
const globalId = resolveGlobalId(Astro.currentLocale)
const globalEntry = await getEntry("globals", globalId)

if (!globalEntry) {
  throw new Error(
    `Global data not found for locale "${Astro.currentLocale ?? globalId}"`
  )
}

const global = globalEntry.data
const { Content } = await render(page)
const pageType = page.data.type

function throwMissingLayout(type: string): never {
  throw new Error(
    `No layout registered for page type "${type}" in src/pages/[...page].astro`
  )
}
---

{
  page.data.type === "about" ? (
    <AboutLayout global={global} page={page.data}>
      <Content />
    </AboutLayout>
  ) : page.data.type === "contact" ? (
    <ContactLayout global={global} page={page.data}>
      <Content />
    </ContactLayout>
  ) : page.data.type === "home" ? (
    <HomeLayout global={global} page={page.data}>
      <Content />
    </HomeLayout>
  ) : page.data.type === "landing" ? (
    <LandingLayout global={global} page={page.data}>
      <Content />
    </LandingLayout>
  ) : page.data.type === "service" ? (
    <ServiceLayout global={global} page={page.data}>
      <Content />
    </ServiceLayout>
  ) : (
    throwMissingLayout(pageType)
  )
}
