---
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  return pages.map((page) => {
    return {
      params: { page: page.id === "index" ? undefined : page.id },
      props: page,
    }
  })
}

const page = Astro.props
const type = page.data.type

// Get the layout component
const layoutFiles = import.meta.glob("../components/layouts/**/*.astro")
const layoutPath = `../components/layouts/${type}.astro`
const layoutFile = (await layoutFiles[layoutPath]?.()) as any
const Layout = layoutFile?.default as any

// Render the page content
const { Content } = await render(page)
---

<Layout {...page.data}>
  <Content />
</Layout>
