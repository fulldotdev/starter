---

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conduit — Human Connection, Digital Craft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground overflow-x-hidden">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-5 flex items-center justify-between nav-glass">
      <a href="/" class="font-human text-lg tracking-tight text-foreground">Conduit</a>
      <div class="hidden md:flex items-center gap-8 text-xs">
        <a href="/surfaces" class="text-muted-foreground hover:text-foreground transition-colors duration-300 tracking-wide">Surfaces</a>
        <a href="/about" class="text-muted-foreground hover:text-foreground transition-colors duration-300 tracking-wide">About</a>
        <a href="#work" class="text-muted-foreground hover:text-foreground transition-colors duration-300 tracking-wide">Work</a>
        <a href="/contact" class="nav-btn">Start a conversation</a>
      </div>
      <button class="md:hidden text-foreground" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
      </button>
    </nav>

    <!-- ==================== HERO ==================== -->
    <section class="min-h-screen relative flex hero-split">
      <!-- Human Side -->
      <div class="split-human flex-1 flex items-center justify-center p-8 md:p-16 relative">
        <div class="paper-texture"></div>
        <div class="max-w-md relative z-10 text-right md:ml-auto md:mr-10">
          <p class="font-human text-sm tracking-widest uppercase text-foreground/40 mb-6 reveal-hand" style="animation-delay:0.3s">We begin with</p>
          <h2 class="font-human text-4xl md:text-6xl leading-[1.05] mb-6 reveal-hand" style="animation-delay:0.5s">
            a human<br/>need
          </h2>
          <p class="font-human text-base text-muted-foreground leading-relaxed reveal-hand" style="animation-delay:0.7s">
            Every great product starts with empathy — with listening, understanding, and feeling what people actually need.
          </p>
          <div class="mt-10 flex items-center gap-3 justify-end reveal-hand" style="animation-delay:0.9s">
            <span class="inline-block w-10 h-px bg-foreground/20"></span>
            <span class="font-human text-xs tracking-wide text-foreground/35 italic">the human side</span>
          </div>
        </div>
      </div>

      <!-- Digital Side -->
      <div class="split-digital flex-1 flex items-center justify-center p-8 md:p-16 relative">
        <div class="grid-dots"></div>
        <div class="max-w-md relative z-10 md:mr-auto md:ml-10">
          <p class="font-code text-xs tracking-widest text-digital-label mb-6 reveal-type" style="animation-delay:0.4s">// and deliver with</p>
          <h2 class="font-code text-3xl md:text-5xl font-medium leading-tight mb-6 reveal-type" style="animation-delay:0.6s">
            precise<br/>technology
          </h2>
          <p class="font-code text-sm text-digital-muted leading-relaxed reveal-type" style="animation-delay:0.8s">
            We translate human intention into elegant code. Performant, accessible, and built to last — technology that serves people.
          </p>
          <div class="mt-10 flex items-center gap-3 reveal-type" style="animation-delay:1s">
            <span class="font-code text-xs text-digital-label">the digital side</span>
            <span class="inline-block w-10 h-px bg-digital-label/50"></span>
          </div>
        </div>
      </div>

      <!-- Center Divider -->
      <div class="center-line"></div>
    </section>

    <!-- ==================== THE BRIDGE ==================== -->
    <section id="about" class="py-28 md:py-40 px-6 relative">
      <div class="max-w-3xl mx-auto text-center relative z-10">
        <div class="inline-flex items-center gap-4 mb-10 scroll-reveal">
          <span class="font-human text-sm italic text-foreground/40">empathy</span>
          <span class="inline-block w-12 h-px bg-foreground/15"></span>
          <span class="font-code text-xs tracking-widest text-foreground/40">technology</span>
        </div>
        <h2 class="text-4xl md:text-5xl leading-[1.1] mb-8 scroll-reveal">
          <span class="font-human">We are </span><span class="font-code text-accent">the bridge</span>
        </h2>
        <p class="text-base text-muted-foreground max-w-2xl mx-auto leading-relaxed scroll-reveal">
          Conduit exists in the space between human connection and digital innovation. We don't choose sides — we build the bridge. Every project weaves the warmth of genuine understanding with the precision of modern engineering.
        </p>
      </div>
    </section>

    <!-- ==================== BENTO GRID ==================== -->
    <section class="py-12 md:py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="bento-grid">
          <!-- Large: Team image -->
          <div class="bento-item bento-team scroll-reveal">
            <div class="bento-image-placeholder">
              <div class="placeholder-inner">
                <svg class="w-8 h-8 text-foreground/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                <span class="text-xs text-foreground/25 mt-2">Team photo</span>
              </div>
            </div>
            <div class="bento-overlay">
              <span class="font-human text-xs tracking-wide text-white/70">Our team</span>
              <h3 class="font-human text-xl text-white mt-1">15 people who care deeply</h3>
            </div>
          </div>

          <!-- Stats -->
          <div class="bento-item bento-stats scroll-reveal">
            <div class="p-6 md:p-8 flex flex-col justify-between h-full bg-foreground text-background rounded-xl">
              <span class="font-code text-[10px] tracking-widest uppercase text-background/40">By the numbers</span>
              <div class="space-y-4 mt-6">
                <div>
                  <span class="font-code text-4xl font-bold">47</span>
                  <p class="text-xs text-background/50 mt-0.5">projects shipped</p>
                </div>
                <div>
                  <span class="font-code text-4xl font-bold">98%</span>
                  <p class="text-xs text-background/50 mt-0.5">client retention</p>
                </div>
                <div>
                  <span class="font-code text-4xl font-bold">12yr</span>
                  <p class="text-xs text-background/50 mt-0.5">of building</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Philosophy quote -->
          <div class="bento-item bento-quote scroll-reveal">
            <div class="p-6 md:p-8 flex flex-col justify-center h-full human-surface rounded-xl">
              <svg class="w-8 h-8 text-accent/30 mb-4" viewBox="0 0 24 24" fill="currentColor"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609L9.978 5.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z"/></svg>
              <blockquote class="font-human text-lg md:text-xl leading-relaxed italic">
                The best technology disappears into the experience. You don't notice it — you just feel <span class="text-accent not-italic font-bold">understood</span>.
              </blockquote>
            </div>
          </div>

          <!-- Services list -->
          <div class="bento-item bento-services scroll-reveal">
            <div class="p-6 md:p-8 h-full digital-surface rounded-xl">
              <span class="font-code text-[10px] tracking-widest uppercase text-digital-label">What we build</span>
              <div class="mt-6 space-y-4">
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span class="font-code text-sm text-digital-fg">Web Applications</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span class="font-code text-sm text-digital-fg">Brand Experiences</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span class="font-code text-sm text-digital-fg">UX & Interface Design</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span class="font-code text-sm text-digital-fg">Digital Strategy</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span class="font-code text-sm text-digital-fg">Platform Engineering</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Workspace image -->
          <div class="bento-item bento-workspace scroll-reveal">
            <div class="bento-image-placeholder">
              <div class="placeholder-inner">
                <svg class="w-8 h-8 text-foreground/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="text-xs text-foreground/25 mt-2">Workspace</span>
              </div>
            </div>
            <div class="bento-overlay">
              <span class="font-human text-xs text-white/70">Portland, OR</span>
              <h3 class="font-human text-base text-white mt-1">Where the magic happens</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FOUNDER VIDEOS ==================== -->
    <section class="py-20 md:py-32 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
          <div>
            <p class="font-code text-xs tracking-widest text-foreground/35 mb-3 scroll-reveal">Straight from the founder</p>
            <h2 class="font-human text-3xl md:text-4xl leading-tight scroll-reveal">
              Hear it from me,<br/><em class="italic text-accent">in my own words</em>
            </h2>
          </div>
          <p class="text-sm text-muted-foreground max-w-sm leading-relaxed scroll-reveal">
            No scripts, no polish — just honest conversations about how we think about building technology for real people.
          </p>
        </div>

        <div class="video-scroll">
          <!-- Video 1 -->
          <div class="video-card scroll-reveal">
            <div class="video-placeholder">
              <div class="video-play-btn">
                <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="video-duration font-code">2:34</div>
            </div>
            <h3 class="font-human text-base font-bold mt-4">Why we start with listening</h3>
            <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">How deep empathy shapes every project we take on, and why it matters more than any framework.</p>
          </div>

          <!-- Video 2 -->
          <div class="video-card scroll-reveal">
            <div class="video-placeholder">
              <div class="video-play-btn">
                <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="video-duration font-code">3:12</div>
            </div>
            <h3 class="font-human text-base font-bold mt-4">The bridge philosophy</h3>
            <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">What it really means to bridge human connection and technology, and how that plays out in practice.</p>
          </div>

          <!-- Video 3 -->
          <div class="video-card scroll-reveal">
            <div class="video-placeholder">
              <div class="video-play-btn">
                <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="video-duration font-code">1:58</div>
            </div>
            <h3 class="font-human text-base font-bold mt-4">How we choose clients</h3>
            <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">Not every project is right for us. Here's what we look for and why alignment matters so much.</p>
          </div>

          <!-- Video 4 -->
          <div class="video-card scroll-reveal">
            <div class="video-placeholder">
              <div class="video-play-btn">
                <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="video-duration font-code">4:05</div>
            </div>
            <h3 class="font-human text-base font-bold mt-4">Building Kinfolk: a case study</h3>
            <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">Walking through how we built one of our favorite projects from first conversation to launch day.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== APPROACH ==================== -->
    <section id="approach" class="py-20 md:py-32 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-12 gap-12 items-start mb-20">
          <div class="md:col-span-5">
            <p class="font-code text-xs tracking-widest text-foreground/35 mb-3 scroll-reveal">Our approach</p>
            <h2 class="font-human text-3xl md:text-4xl leading-tight scroll-reveal">
              <span class="font-human">Two worlds,</span><br/>
              <span class="font-code text-accent">one process</span>
            </h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="text-base text-muted-foreground leading-relaxed scroll-reveal">
              Every project flows through both halves of who we are. The human craft shapes <em>what</em> we build. The digital craft shapes <em>how</em> we build it. They're inseparable.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-px bg-foreground/8 rounded-xl overflow-hidden">
          <!-- Human column -->
          <div class="bg-background p-8 md:p-10">
            <span class="font-human text-xs tracking-[0.15em] uppercase text-foreground/30 block mb-8">The human craft</span>
            <div class="space-y-8">
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-human text-xl text-foreground/20">1</span>
                  <h3 class="font-human text-lg">Listen deeply</h3>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed pl-8">Genuine curiosity about users. Their context, frustrations, unspoken needs — the kind of understanding that only comes from real attention.</p>
              </div>
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-human text-xl text-foreground/20">2</span>
                  <h3 class="font-human text-lg">Shape the feeling</h3>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed pl-8">Mapping the emotional arc before the visual one. How should someone feel at every touchpoint? The story guides the structure.</p>
              </div>
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-human text-xl text-foreground/20">3</span>
                  <h3 class="font-human text-lg">Observe & refine</h3>
                </div>
                <p class="text-sm text-muted-foreground leading-relaxed pl-8">Watching real people interact with what we build. Their reactions — hesitation, delight, confusion — guide every refinement.</p>
              </div>
            </div>
          </div>
          <!-- Digital column -->
          <div class="digital-surface-alt p-8 md:p-10">
            <span class="font-code text-[10px] tracking-[0.15em] uppercase text-digital-label block mb-8">The digital craft</span>
            <div class="space-y-8">
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-code text-sm text-digital-label/60">01</span>
                  <h3 class="font-code text-base font-medium text-digital-fg">Architect</h3>
                </div>
                <p class="font-code text-xs text-digital-muted leading-relaxed pl-10">Solid foundations for real-world scale. Technology choices driven by your needs, not trends. Performance and maintainability first.</p>
              </div>
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-code text-sm text-digital-label/60">02</span>
                  <h3 class="font-code text-base font-medium text-digital-fg">Build</h3>
                </div>
                <p class="font-code text-xs text-digital-muted leading-relaxed pl-10">Clean, tested, well-documented code. Every component crafted with the care of something meant to last and be understood.</p>
              </div>
              <div class="scroll-reveal">
                <div class="flex items-baseline gap-3 mb-2">
                  <span class="font-code text-sm text-digital-label/60">03</span>
                  <h3 class="font-code text-base font-medium text-digital-fg">Iterate</h3>
                </div>
                <p class="font-code text-xs text-digital-muted leading-relaxed pl-10">Continuous feedback loops. Human insight informs technical decisions; data reshapes the human experience. The cycle never stops.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== WORK ==================== -->
    <section id="work" class="py-20 md:py-32 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
          <div>
            <p class="font-code text-xs tracking-widest text-foreground/35 mb-3 scroll-reveal">Selected projects</p>
            <h2 class="text-3xl md:text-4xl scroll-reveal">
              <span class="font-human">Bridges</span> <span class="font-code text-accent">we've built</span>
            </h2>
          </div>
        </div>

        <!-- Project 1: Large feature -->
        <div class="project-feature group scroll-reveal mb-8">
          <div class="grid md:grid-cols-12 gap-6 items-center">
            <div class="md:col-span-7">
              <div class="project-image-placeholder aspect-[16/10] rounded-xl">
                <div class="placeholder-inner">
                  <svg class="w-10 h-10 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  <span class="text-xs text-foreground/20 mt-2">Project screenshot</span>
                </div>
              </div>
            </div>
            <div class="md:col-span-4 md:col-start-9">
              <span class="font-human text-xs text-foreground/40">Community platform</span>
              <h3 class="font-human text-2xl md:text-3xl mt-2 group-hover:text-accent transition-colors duration-300">Kinfolk</h3>
              <p class="text-sm text-muted-foreground mt-3 leading-relaxed">A place where genuine connections find a home. Built for belonging, designed for warmth.</p>
              <a href="#" class="inline-flex items-center gap-2 text-sm text-accent mt-5 group-hover:gap-3 transition-all duration-300">
                <span class="font-human">View project</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Projects 2-4: Grid -->
        <div class="grid md:grid-cols-3 gap-6">
          <a href="#" class="project-card group scroll-reveal">
            <div class="project-image-placeholder-sm aspect-[4/3] rounded-lg mb-4">
              <div class="placeholder-inner">
                <svg class="w-6 h-6 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            </div>
            <span class="font-code text-[10px] text-foreground/35 tracking-wide">Healthcare</span>
            <h3 class="font-human text-lg mt-1.5 group-hover:text-accent transition-colors duration-300">Meridian Health</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">Patient care portal — complex systems, gentle interface.</p>
          </a>
          <a href="#" class="project-card group scroll-reveal">
            <div class="project-image-placeholder-sm aspect-[4/3] rounded-lg mb-4">
              <div class="placeholder-inner">
                <svg class="w-6 h-6 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            </div>
            <span class="font-code text-[10px] text-foreground/35 tracking-wide">Publishing</span>
            <h3 class="font-human text-lg mt-1.5 group-hover:text-accent transition-colors duration-300">Storyweave</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">Digital publishing — stories deserve beautiful tools.</p>
          </a>
          <a href="#" class="project-card group scroll-reveal">
            <div class="project-image-placeholder-sm aspect-[4/3] rounded-lg mb-4">
              <div class="placeholder-inner">
                <svg class="w-6 h-6 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            </div>
            <span class="font-code text-[10px] text-foreground/35 tracking-wide">Education</span>
            <h3 class="font-human text-lg mt-1.5 group-hover:text-accent transition-colors duration-300">Hearthstone Learning</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">Education ecosystem — curiosity as the curriculum.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section id="connect" class="py-20 md:py-32 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="cta-container rounded-2xl overflow-hidden">
          <div class="grid md:grid-cols-12 min-h-[500px]">
            <!-- Left: Personal / image -->
            <div class="md:col-span-5 relative cta-human-side p-8 md:p-12 flex flex-col justify-end">
              <div class="cta-founder-placeholder">
                <div class="placeholder-inner">
                  <svg class="w-10 h-10 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4-4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <span class="text-xs text-white/25 mt-2">Founder photo</span>
                </div>
              </div>
              <div class="relative z-10">
                <p class="font-human text-white/80 text-sm italic leading-relaxed">
                  "I started Conduit because I was tired of technology that felt cold. Every project we take on is a chance to prove it can be different."
                </p>
                <div class="mt-4">
                  <span class="font-human text-white text-sm font-bold">Alex Chen</span>
                  <span class="font-code text-white/40 text-xs ml-2">Founder</span>
                </div>
              </div>
            </div>
            <!-- Right: CTA content -->
