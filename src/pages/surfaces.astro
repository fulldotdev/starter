---

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conduit — Surfaces</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground overflow-x-hidden">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 px-6 md:px-10 py-5 flex items-center justify-between nav-glass">
      <a href="/" class="font-human text-lg tracking-tight text-foreground">Conduit</a>
      <div class="hidden md:flex items-center gap-8 text-xs">
        <a href="/surfaces" class="text-foreground transition-colors duration-300 tracking-wide">Surfaces</a>
        <a href="/about" class="text-muted-foreground hover:text-foreground transition-colors duration-300 tracking-wide">About</a>
        <a href="/#work" class="text-muted-foreground hover:text-foreground transition-colors duration-300 tracking-wide">Work</a>
        <a href="/contact" class="nav-btn">Start a conversation</a>
      </div>
      <button class="md:hidden text-foreground" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
      </button>
    </nav>

    <!-- ==================== HERO ==================== -->
    <section class="pt-32 pb-20 md:pt-40 md:pb-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-end">
          <div class="md:col-span-7">
            <p class="font-code text-xs tracking-widest text-foreground/35 mb-4 reveal" style="animation-delay:0.2s">What we build</p>
            <h1 class="font-human text-4xl md:text-6xl lg:text-7xl leading-[1.02] reveal" style="animation-delay:0.3s">
              The surfaces<br/>where people<br/>meet <em class="italic text-accent">technology</em>
            </h1>
          </div>
          <div class="md:col-span-4 md:col-start-9">
            <p class="text-base text-muted-foreground leading-relaxed reveal" style="animation-delay:0.5s">
              Every interface is a surface — a meeting point between human intention and digital response. We craft each one with obsessive care.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="max-w-5xl mx-auto px-6"><div class="h-px bg-foreground/8"></div></div>

    <!-- ==================== SERVICE 1: Web Applications ==================== -->
    <section class="py-20 md:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-center">
          <div class="md:col-span-6">
            <div class="service-image aspect-[4/3] rounded-xl overflow-hidden">
              <div class="placeholder-inner">
                <svg class="w-10 h-10 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="text-xs text-foreground/20 mt-2">Application screenshot</span>
              </div>
            </div>
          </div>
          <div class="md:col-span-5 md:col-start-8">
            <div class="scroll-reveal">
              <span class="font-code text-[10px] tracking-widest text-foreground/35">01</span>
              <h2 class="font-human text-3xl md:text-4xl leading-tight mt-3 mb-5">Web Applications</h2>
              <p class="text-base text-muted-foreground leading-relaxed mb-6">
                Full-stack platforms built for real-world complexity. We specialize in the kind of software that people rely on every day — the tools that need to be fast, reliable, and a genuine pleasure to use.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">SaaS platforms & dashboards</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">Customer-facing portals</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">Internal tools & workflows</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">E-commerce experiences</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICE 2: Brand Experience ==================== -->
    <section class="py-20 md:py-32 px-6 digital-section">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-center">
          <div class="md:col-span-5 md:order-1">
            <div class="scroll-reveal">
              <span class="font-code text-[10px] tracking-widest text-digital-label">02</span>
              <h2 class="font-human text-3xl md:text-4xl leading-tight mt-3 mb-5 text-digital-fg">Brand Experience</h2>
              <p class="text-sm text-digital-muted leading-relaxed mb-6">
                Your brand is more than a logo — it's every moment someone interacts with you. We build cohesive digital brand systems that translate your essence into pixels, motion, and interaction.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Visual identity systems</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Marketing websites</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Design systems & component libraries</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Motion & interaction design</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="md:col-span-6 md:col-start-7 md:order-2">
            <div class="service-image-dark aspect-[4/3] rounded-xl overflow-hidden scroll-reveal">
              <div class="placeholder-inner">
                <svg class="w-10 h-10 text-white/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span class="text-xs text-white/20 mt-2">Brand showcase</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICE 3: UX & Interface Design ==================== -->
    <section class="py-20 md:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-center">
          <div class="md:col-span-6">
            <div class="service-image aspect-[4/3] rounded-xl overflow-hidden scroll-reveal">
              <div class="placeholder-inner">
                <svg class="w-10 h-10 text-foreground/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span class="text-xs text-foreground/20 mt-2">Design process</span>
              </div>
            </div>
          </div>
          <div class="md:col-span-5 md:col-start-8">
            <div class="scroll-reveal">
              <span class="font-code text-[10px] tracking-widest text-foreground/35">03</span>
              <h2 class="font-human text-3xl md:text-4xl leading-tight mt-3 mb-5">UX & Interface Design</h2>
              <p class="text-base text-muted-foreground leading-relaxed mb-6">
                Research-driven design that puts real humans first. We create interfaces where every interaction feels natural — the kind of product design where you never have to think about the interface because it just works.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">User research & testing</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">Information architecture</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">Wireframing & prototyping</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-foreground/70">Accessibility audits</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SERVICE 4: Digital Strategy ==================== -->
    <section class="py-20 md:py-32 px-6 digital-section">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-center">
          <div class="md:col-span-5 md:order-1">
            <div class="scroll-reveal">
              <span class="font-code text-[10px] tracking-widest text-digital-label">04</span>
              <h2 class="font-human text-3xl md:text-4xl leading-tight mt-3 mb-5 text-digital-fg">Digital Strategy</h2>
              <p class="text-sm text-digital-muted leading-relaxed mb-6">
                Technology roadmaps that serve people first. We help you see around corners — choosing the right tools, the right architecture, the right pace of growth. Strategy that's grounded in reality, not buzzwords.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Technology audits</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Architecture planning</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Product roadmapping</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 flex-shrink-0"></span>
                  <span class="font-code text-sm text-digital-muted">Team & process consulting</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="md:col-span-6 md:col-start-7 md:order-2">
            <div class="service-image-dark aspect-[4/3] rounded-xl overflow-hidden scroll-reveal">
              <div class="placeholder-inner">
                <svg class="w-10 h-10 text-white/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                <span class="text-xs text-white/20 mt-2">Strategy diagram</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FOUNDER VIDEO ==================== -->
    <section class="py-20 md:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-12 gap-10 items-center">
          <div class="md:col-span-3">
            <div class="video-placeholder-vertical rounded-xl scroll-reveal">
              <div class="video-play-btn">
                <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="video-duration font-code">3:45</div>
            </div>
          </div>
          <div class="md:col-span-7 md:col-start-5">
            <div class="scroll-reveal">
              <p class="font-code text-xs tracking-widest text-foreground/35 mb-3">From the founder</p>
              <h2 class="font-human text-3xl md:text-4xl leading-tight mb-5">
                How we think about <em class="italic text-accent">craft</em>
              </h2>
              <p class="text-base text-muted-foreground leading-relaxed mb-6">
                Every surface we build is a point of contact between a person and your product. I walk through how we approach each one with the care it deserves — and why the details matter more than most agencies will admit.
              </p>
              <a href="/contact" class="inline-flex items-center gap-2 text-sm text-accent group">
                <span class="font-human">Discuss your project</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CTA ==================== -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="font-human text-3xl md:text-5xl leading-[1.08] mb-6 scroll-reveal">
          Have a surface that<br/>needs <em class="italic text-accent">crafting</em>?
        </h2>
        <p class="text-base text-muted-foreground max-w-md mx-auto mb-10 scroll-reveal">
          Tell us about your project. We'll tell you honestly whether we're the right fit.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center scroll-reveal">
          <a href="/contact" class="cta-primary">
            <span>Start a conversation</span>
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== FOOTER ==================== -->
    <footer class="border-t border-foreground/8 py-10 px-6">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
        <span class="font-code">&copy; 2026 Conduit</span>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-foreground transition-colors">Twitter</a>
          <a href="#" class="hover:text-foreground transition-colors">LinkedIn</a>
          <a href="#" class="hover:text-foreground transition-colors">Dribbble</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --radius: 0.625rem;
    --background: oklch(0.97 0.01 80);
    --foreground: oklch(0.18 0.015 55);
    --card: oklch(0.95 0.01 80);
    --card-foreground: oklch(0.18 0.015 55);
    --popover: oklch(0.97 0.01 80);
    --popover-foreground: oklch(0.18 0.015 55);
    --primary: oklch(0.65 0.12 70);
    --primary-foreground: oklch(0.98 0 0);
    --secondary: oklch(0.94 0.01 80);
    --secondary-foreground: oklch(0.22 0.01 55);
    --muted: oklch(0.93 0.01 80);
    --muted-foreground: oklch(0.5 0.02 55);
    --accent: oklch(0.94 0.01 80);
    --accent-foreground: oklch(0.22 0.01 55);
    --destructive: oklch(0.577 0.245 27.325);
    --destructive-foreground: oklch(0.985 0 0);
    --border: oklch(0.85 0.015 75 / 50%);
    --input: oklch(0.85 0.015 75 / 50%);
    --ring: oklch(0.65 0.12 70);
  }
</style>

<style>
  .font-human { font-family: 'Libre Baskerville', Georgia, serif; }
  .font-code { font-family: 'JetBrains Mono', monospace; }
  body { font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; }

  .text-accent { color: oklch(0.65 0.12 70); }
  .bg-accent { background-color: oklch(0.65 0.12 70); }
  .text-digital-muted { color: oklch(0.52 0.015 240); }
  .text-digital-fg { color: oklch(0.88 0.01 240); }
  .text-digital-label { color: oklch(0.6 0.03 240); }

  .nav-glass {
    backdrop-filter: blur(16px);
    background: oklch(0.97 0.01 80 / 85%);
    border-bottom: 1px solid oklch(0.18 0.015 55 / 6%);
  }
  .nav-btn {
    padding: 0.45rem 1.2rem;
    border: 1px solid oklch(0.65 0.12 70 / 40%);
    border-radius: 6px;
    color: oklch(0.65 0.12 70);
    font-family: 'Libre Baskerville', serif;
    font-size: 0.75rem;
    transition: all 0.3s;
  }
  .nav-btn:hover {
    background: oklch(0.65 0.12 70 / 6%);
    border-color: oklch(0.65 0.12 70 / 70%);
  }

  .digital-section {
    background: oklch(0.15 0.01 240);
    color: oklch(0.88 0.01 240);
    margin: 0 -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  @media (min-width: 768px) {
    .digital-section { margin: 0; padding-left: 1.5rem; padding-right: 1.5rem; border-radius: 0; }
  }

  .service-image {
    background: linear-gradient(135deg, oklch(0.92 0.015 78) 0%, oklch(0.88 0.02 75) 100%);
    display: flex; align-items: center; justify-content: center;
    border: 1px solid oklch(0.88 0.015 75 / 40%);
  }
  .service-image-dark {
    background: linear-gradient(135deg, oklch(0.2 0.015 240) 0%, oklch(0.14 0.01 240) 100%);
    display: flex; align-items: center; justify-content: center;
    border: 1px solid oklch(0.3 0.01 240 / 30%);
  }
  .placeholder-inner { display: flex; flex-direction: column; align-items: center; }

  .video-placeholder-vertical {
    aspect-ratio: 9/16;
    background: linear-gradient(160deg, oklch(0.2 0.015 55) 0%, oklch(0.14 0.01 55) 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .video-play-btn {
    width: 52px; height: 52px; border-radius: 50%;
    background: oklch(0.65 0.12 70 / 80%);
    display: flex; align-items: center; justify-content: center;
  }
  .video-duration {
    position: absolute; bottom: 10px; right: 10px;
    background: oklch(0 0 0 / 50%); color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px;
  }

  .cta-primary {
    display: inline-flex; align-items: center;
    padding: 0.85rem 1.75rem;
    background: oklch(0.65 0.12 70); color: white;
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 500;
    transition: all 0.3s;
  }
  .cta-primary:hover {
    background: oklch(0.58 0.12 70); transform: translateY(-2px);
    box-shadow: 0 8px 25px oklch(0.65 0.12 70 / 20%);
  }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .reveal { animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .scroll-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .scroll-reveal.visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  const reveals = document.querySelectorAll('.scroll-reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
  reveals.forEach(el => observer.observe(el));
</script>
