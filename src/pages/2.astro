---
import "@/styles/global.css"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
---

<Layout>
  <LayoutHead title="Services — Conduit" description="From strategy to deployment, we offer end-to-end web development services designed to put people first.">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </LayoutHead>
  <LayoutBody>
    <LayoutMain class="relative">

      <!-- Decorative lines -->
      <div class="deco-line deco-line-1"></div>
      <div class="deco-line deco-line-2"></div>

      <!-- Nav -->
      <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-5 md:px-12 lg:px-20 nav-blur">
        <a href="/1" class="font-display text-xl tracking-tight">Conduit</a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/2" class="font-body text-sm font-medium text-[var(--foreground)]">Services</a>
          <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
          <a href="/4" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Work</a>
          <a href="/5" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Contact</a>
        </div>
        <a href="/5" class="font-body text-sm border border-[var(--border)] px-4 py-2 rounded-full hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-all duration-300">Let's Talk</a>
      </nav>

      <!-- Hero -->
      <section class="px-6 md:px-12 lg:px-20 pt-32 pb-20 relative">
        <div class="max-w-4xl">
          <p class="font-body text-sm uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-6 fade-in" style="animation-delay: 0.1s">What We Do</p>
          <h1 class="font-display text-5xl md:text-6xl lg:text-7xl leading-[1] tracking-tight mb-8">
            <span class="line-reveal" style="animation-delay: 0.2s">Services built around</span><br />
            <span class="line-reveal" style="animation-delay: 0.4s"><em class="italic accent-underline">your people.</em></span>
          </h1>
          <p class="font-body text-lg text-[var(--muted-foreground)] max-w-xl leading-relaxed fade-in" style="animation-delay: 0.6s">
            We don't offer cookie-cutter packages. Every engagement starts with understanding your audience — then engineering solutions that truly serve them.
          </p>
        </div>
        <!-- Decorative circle -->
        <div class="absolute top-24 right-12 lg:right-32 w-48 h-48 md:w-72 md:h-72 rounded-full border border-[var(--border)] opacity-40 deco-circle hidden md:block"></div>
      </section>

      <!-- Core Services Grid -->
      <section class="px-6 md:px-12 lg:px-20 py-24 border-t border-[var(--border)] reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

          <!-- Service 1 -->
          <div class="border-b lg:border-r lg:border-b-0 border-[var(--border)] pb-12 lg:pb-0 lg:pr-12 mb-12 lg:mb-0 reveal-item service-card" style="animation-delay: 0.1s">
            <div class="flex items-start gap-4 mb-6">
              <span class="font-body text-xs text-[var(--muted-foreground)] mt-1 service-number">01</span>
              <div>
                <h3 class="font-display text-3xl md:text-4xl mb-4">Strategy &<br />Discovery</h3>
                <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">Before we design a single pixel, we immerse ourselves in your world. User research, competitive analysis, and stakeholder alignment — to build a foundation rooted in real insight.</p>
                <ul class="space-y-2">
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>User Research & Interviews</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Competitive Landscape Analysis</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Information Architecture</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Product Roadmapping</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Service 2 -->
          <div class="lg:pl-12 reveal-item service-card" style="animation-delay: 0.25s">
            <div class="flex items-start gap-4 mb-6">
              <span class="font-body text-xs text-[var(--muted-foreground)] mt-1 service-number">02</span>
              <div>
                <h3 class="font-display text-3xl md:text-4xl mb-4">Design &<br />Experience</h3>
                <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">We design interfaces that feel intuitive and look extraordinary. Every interaction is considered, every detail intentional — because great design builds trust.</p>
                <ul class="space-y-2">
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>UI/UX Design</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Design Systems & Components</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Prototyping & Usability Testing</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Brand Identity for Digital</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Services continued -->
      <section class="px-6 md:px-12 lg:px-20 py-24 border-t border-[var(--border)] reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

          <!-- Service 3 -->
          <div class="border-b lg:border-r lg:border-b-0 border-[var(--border)] pb-12 lg:pb-0 lg:pr-12 mb-12 lg:mb-0 reveal-item service-card" style="animation-delay: 0.1s">
            <div class="flex items-start gap-4 mb-6">
              <span class="font-body text-xs text-[var(--muted-foreground)] mt-1 service-number">03</span>
              <div>
                <h3 class="font-display text-3xl md:text-4xl mb-4">Engineering &<br />Development</h3>
                <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">We write code that's clean, performant, and built to last. Modern frameworks, rigorous testing, and an obsession with page speed ensure your product feels fast and reliable.</p>
                <ul class="space-y-2">
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Frontend Development (React, Astro, Next.js)</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Backend & API Architecture</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>CMS Integration & Headless Setups</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Performance Optimization</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Service 4 -->
          <div class="lg:pl-12 reveal-item service-card" style="animation-delay: 0.25s">
            <div class="flex items-start gap-4 mb-6">
              <span class="font-body text-xs text-[var(--muted-foreground)] mt-1 service-number">04</span>
              <div>
                <h3 class="font-display text-3xl md:text-4xl mb-4">Growth &<br />Partnership</h3>
                <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">Launch is just the beginning. We partner with you to measure, iterate, and grow — turning your website into a living product that evolves with your audience.</p>
                <ul class="space-y-2">
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Analytics & Conversion Tracking</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>A/B Testing & Experimentation</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>Ongoing Maintenance & Support</li>
                  <li class="font-body text-sm flex items-center gap-3 service-list-item"><span class="w-1.5 h-1.5 rounded-full bg-[var(--foreground)] service-dot"></span>SEO & Accessibility Audits</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Process -->
      <section class="px-6 md:px-12 lg:px-20 py-24 bg-[var(--secondary)] relative overflow-hidden reveal-section">
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--foreground)]/20 to-transparent"></div>
        <div class="max-w-3xl mb-16">
          <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Our Process</p>
          <h2 class="font-display text-4xl md:text-5xl tracking-tight">How we work <em class="italic">with</em> you.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
          <!-- Connecting line -->
          <div class="hidden md:block absolute top-10 left-[12.5%] right-[12.5%] h-px process-line"></div>
          <div class="reveal-item relative" style="animation-delay: 0.1s">
            <div class="process-step-marker"></div>
            <p class="font-display text-5xl text-[var(--foreground)]/10 mb-4">1</p>
            <h4 class="font-body text-sm font-medium uppercase tracking-wide mb-2">Listen</h4>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Deep conversations with your team and users to uncover what matters most.</p>
          </div>
          <div class="reveal-item relative" style="animation-delay: 0.25s">
            <div class="process-step-marker"></div>
            <p class="font-display text-5xl text-[var(--foreground)]/10 mb-4">2</p>
            <h4 class="font-body text-sm font-medium uppercase tracking-wide mb-2">Envision</h4>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Collaborative design sprints to shape the right solution together.</p>
          </div>
          <div class="reveal-item relative" style="animation-delay: 0.4s">
            <div class="process-step-marker"></div>
            <p class="font-display text-5xl text-[var(--foreground)]/10 mb-4">3</p>
            <h4 class="font-body text-sm font-medium uppercase tracking-wide mb-2">Build</h4>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Agile development with weekly demos — no surprises at launch.</p>
          </div>
          <div class="reveal-item relative" style="animation-delay: 0.55s">
            <div class="process-step-marker"></div>
            <p class="font-display text-5xl text-[var(--foreground)]/10 mb-4">4</p>
            <h4 class="font-body text-sm font-medium uppercase tracking-wide mb-2">Grow</h4>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Post-launch optimization and continuous partnership.</p>
          </div>
        </div>
      </section>

      <!-- Pricing Philosophy -->
      <section class="px-6 md:px-12 lg:px-20 py-24 reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="reveal-item" style="animation-delay: 0.1s">
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Investment</p>
            <h2 class="font-display text-4xl md:text-5xl tracking-tight mb-6">Transparent<br />pricing, real <em class="italic">value.</em></h2>
            <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">We don't hide behind vague quotes. Every project starts with a clear scope, honest timeline, and a price that reflects the value we deliver — not billable hours.</p>
            <a href="/5" class="font-body text-sm underline underline-offset-4 decoration-[var(--border)] hover:decoration-[var(--foreground)] transition-all duration-300">Discuss your project →</a>
          </div>
          <div class="space-y-6 reveal-item" style="animation-delay: 0.25s">
            <div class="border border-[var(--border)] rounded-lg p-6 pricing-card">
              <div class="flex items-baseline justify-between mb-2">
                <h4 class="font-display text-xl">Focused Sprint</h4>
                <p class="font-body text-sm text-[var(--muted-foreground)]">From $15K</p>
              </div>
              <p class="font-body text-sm text-[var(--muted-foreground)]">A single, high-impact deliverable — landing page, product feature, or brand refresh. 4–6 weeks.</p>
            </div>
            <div class="border border-[var(--border)] rounded-lg p-6 pricing-card">
              <div class="flex items-baseline justify-between mb-2">
                <h4 class="font-display text-xl">Full Build</h4>
                <p class="font-body text-sm text-[var(--muted-foreground)]">From $50K</p>
              </div>
              <p class="font-body text-sm text-[var(--muted-foreground)]">End-to-end product development — from research through launch and beyond. 3–6 months.</p>
            </div>
            <div class="border border-[var(--border)] rounded-lg p-6 pricing-card">
              <div class="flex items-baseline justify-between mb-2">
                <h4 class="font-display text-xl">Ongoing Partnership</h4>
                <p class="font-body text-sm text-[var(--muted-foreground)]">From $8K/mo</p>
              </div>
              <p class="font-body text-sm text-[var(--muted-foreground)]">Dedicated team embedded in your workflow — continuous design, development, and optimization.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="px-6 md:px-12 lg:px-20 py-24 bg-[var(--foreground)] text-[var(--background)] relative overflow-hidden reveal-section">
        <div class="absolute inset-0 cta-mesh"></div>
        <div class="max-w-3xl mx-auto text-center relative">
          <h2 class="font-display text-4xl md:text-5xl tracking-tight mb-6">Let's find the right<br /><em class="italic">fit</em> for you.</h2>
          <p class="font-body text-lg opacity-70 mb-10 max-w-lg mx-auto">No pressure. Just a real conversation about what you're building and how we can help.</p>
          <a href="/5" class="font-body text-sm bg-[var(--background)] text-[var(--foreground)] px-8 py-3.5 rounded-full inline-block hover:scale-[1.03] hover:shadow-xl active:scale-[0.98] transition-all duration-300">Get in Touch</a>
        </div>
      </section>

      <!-- Footer -->
      <footer class="px-6 md:px-12 lg:px-20 py-12 border-t border-[var(--border)]">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
          <div>
            <a href="/1" class="font-display text-lg tracking-tight hover:opacity-70 transition-opacity duration-300">Conduit</a>
            <p class="font-body text-sm text-[var(--muted-foreground)] mt-1">Bridging human connection & technology.</p>
          </div>
          <div class="flex flex-wrap gap-6">
            <a href="/2" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Services</a>
            <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
            <a href="/4" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Work</a>
            <a href="/5" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Contact</a>
          </div>
          <p class="font-body text-xs text-[var(--muted-foreground)]">© 2026 Conduit. All rights reserved.</p>
        </div>
      </footer>

    </LayoutMain>
  </LayoutBody>
</Layout>

<style is:global>
  :root {
    --radius: 0.625rem;
    --background: oklch(0.97 0.005 80);
    --foreground: oklch(0.15 0.01 70);
    --card: oklch(1 0 0);
    --card-foreground: oklch(0.15 0.01 70);
    --popover: oklch(1 0 0);
    --popover-foreground: oklch(0.15 0.01 70);
    --primary: oklch(0.15 0.01 70);
    --primary-foreground: oklch(0.97 0.005 80);
    --secondary: oklch(0.93 0.008 80);
    --secondary-foreground: oklch(0.15 0.01 70);
    --muted: oklch(0.93 0.008 80);
    --muted-foreground: oklch(0.50 0.02 70);
    --accent: oklch(0.93 0.008 80);
    --accent-foreground: oklch(0.15 0.01 70);
    --destructive: oklch(0.577 0.245 27.325);
    --destructive-foreground: oklch(0.985 0 0);
    --border: oklch(0.15 0.01 70 / 12%);
    --input: oklch(0.15 0.01 70 / 15%);
    --ring: oklch(0.708 0 0);
  }

  .font-display {
    font-family: 'Playfair Display', serif;
  }
  .font-body {
    font-family: 'Outfit', sans-serif;
  }

  /* === NAV BLUR === */
  .nav-blur {
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    background: oklch(0.97 0.005 80 / 75%);
  }

  /* === HERO ANIMATIONS === */
  .line-reveal {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
    animation: line-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes line-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* === ACCENT UNDERLINE === */
  .accent-underline {
    position: relative;
  }
  .accent-underline::after {
    content: '';
    position: absolute;
    bottom: 0.05em;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--foreground);
    opacity: 0.2;
    transform: scaleX(0);
    transform-origin: left;
    animation: underline-draw 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
  }

  @keyframes underline-draw {
    to { transform: scaleX(1); }
  }

  /* === DECORATIVE CIRCLE === */
  .deco-circle {
    animation: circle-spin 40s linear infinite;
    border-style: dashed;
    border-width: 1px;
  }

  @keyframes circle-spin {
    to { transform: rotate(360deg); }
  }

  /* === DECORATIVE LINES === */
  .deco-line {
    position: absolute;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--border), transparent);
    z-index: 0;
    pointer-events: none;
  }
  .deco-line-1 {
    left: 25%;
    top: 0;
    bottom: 0;
    opacity: 0.5;
  }
  .deco-line-2 {
    left: 75%;
    top: 0;
    bottom: 0;
    opacity: 0.3;
  }

  /* === SCROLL REVEAL === */
  .reveal-section .reveal-item {
    opacity: 0;
    transform: translateY(24px);
  }
  .reveal-section.is-visible .reveal-item {
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* === SERVICE CARDS === */
  .service-card {
    transition: background 0.3s ease;
  }
  .service-card:hover .service-number {
    color: var(--foreground);
  }
  .service-number {
    transition: color 0.3s ease;
  }
  .service-dot {
    transition: transform 0.3s ease;
  }
  .service-list-item:hover .service-dot {
    transform: scale(1.6);
  }

  /* === PRICING CARDS === */
  .pricing-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }
  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px oklch(0 0 0 / 8%);
    border-color: oklch(0.15 0.01 70 / 25%);
  }

  /* === PROCESS LINE === */
  .process-line {
    background: repeating-linear-gradient(
      90deg,
      var(--foreground) 0,
      var(--foreground) 6px,
      transparent 6px,
      transparent 14px
    );
    opacity: 0.12;
  }

  /* === CTA MESH === */
  .cta-mesh {
    background-image:
      radial-gradient(oklch(1 0 0 / 4%) 1px, transparent 1px),
      radial-gradient(oklch(1 0 0 / 2%) 1px, transparent 1px);
    background-size: 24px 24px, 48px 48px;
    background-position: 0 0, 12px 12px;
  }
</style>

<script>
  const sections = document.querySelectorAll('.reveal-section');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });
  sections.forEach(section => observer.observe(section));
</script>
