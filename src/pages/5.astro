---
import "@/styles/global.css"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
---

<Layout>
  <LayoutHead title="Contact — Conduit" description="Start a conversation with Conduit. We'd love to hear about the problem you're solving and the people you're building for.">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gambetta:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </LayoutHead>
  <LayoutBody>
    <LayoutMain class="relative overflow-hidden">

      <!-- Warm ambient gradient -->
      <div class="warm-ambient"></div>

      <!-- Nav -->
      <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-5 md:px-12 lg:px-20 nav-blur">
        <a href="/1" class="font-display text-xl">Conduit</a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/2" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Services</a>
          <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
          <a href="/4" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Work</a>
          <a href="/5" class="font-body text-sm font-medium text-[var(--foreground)]">Contact</a>
        </div>
        <a href="/5" class="font-body text-sm border border-[var(--border)] px-4 py-2 rounded-full hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-all duration-300">Let's Talk</a>
      </nav>

      <!-- Hero -->
      <section class="px-6 md:px-12 lg:px-20 pt-32 pb-12 relative">
        <div class="max-w-3xl">
          <p class="font-body text-sm uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-6 fade-in" style="animation-delay: 0.1s">Get In Touch</p>
          <h1 class="font-display text-5xl md:text-6xl lg:text-7xl leading-[1] tracking-tight mb-8">
            <span class="line-reveal" style="animation-delay: 0.2s">Let's start a</span><br />
            <span class="line-reveal" style="animation-delay: 0.4s"><em class="italic">conversation</em><span class="typing-cursor">.</span></span>
          </h1>
          <p class="font-body text-lg text-[var(--muted-foreground)] max-w-xl leading-relaxed fade-in" style="animation-delay: 0.65s">
            Every great project begins with a genuine conversation. Tell us about the people you're building for, the problems you're facing, and where you want to go.
          </p>
        </div>
      </section>

      <!-- Contact Form + Info -->
      <section class="px-6 md:px-12 lg:px-20 py-24 reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 lg:gap-20">

          <!-- Form -->
          <div class="lg:col-span-3 reveal-item" style="animation-delay: 0.1s">
            <form class="space-y-8">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                  <label class="font-body text-sm font-medium block mb-2">Name</label>
                  <input type="text" placeholder="Your full name" class="contact-input" />
                </div>
                <div class="form-group">
                  <label class="font-body text-sm font-medium block mb-2">Email</label>
                  <input type="email" placeholder="you@company.com" class="contact-input" />
                </div>
              </div>
              <div class="form-group">
                <label class="font-body text-sm font-medium block mb-2">Company</label>
                <input type="text" placeholder="Your company or organization" class="contact-input" />
              </div>
              <div class="form-group">
                <label class="font-body text-sm font-medium block mb-2">What are you looking for?</label>
                <div class="flex flex-wrap gap-3 mt-3">
                  <button type="button" class="pill-button">New Website</button>
                  <button type="button" class="pill-button">Web App</button>
                  <button type="button" class="pill-button">Redesign</button>
                  <button type="button" class="pill-button">Consulting</button>
                  <button type="button" class="pill-button">Partnership</button>
                  <button type="button" class="pill-button">Other</button>
                </div>
              </div>
              <div class="form-group">
                <label class="font-body text-sm font-medium block mb-2">Budget Range</label>
                <div class="flex flex-wrap gap-3 mt-3">
                  <button type="button" class="pill-button">$10K – $25K</button>
                  <button type="button" class="pill-button">$25K – $50K</button>
                  <button type="button" class="pill-button">$50K – $100K</button>
                  <button type="button" class="pill-button">$100K+</button>
                </div>
              </div>
              <div class="form-group">
                <label class="font-body text-sm font-medium block mb-2">Tell us about your project</label>
                <textarea rows="5" placeholder="What problem are you solving? Who are you building for? What does success look like?" class="contact-textarea"></textarea>
              </div>
              <button type="submit" class="submit-btn font-body text-sm bg-[var(--foreground)] text-[var(--background)] px-8 py-3.5 rounded-full hover:scale-[1.02] hover:shadow-lg active:scale-[0.98] transition-all duration-300">Send Message</button>
            </form>
          </div>

          <!-- Sidebar Info -->
          <div class="lg:col-span-2 space-y-12 reveal-item" style="animation-delay: 0.25s">
            <div class="sidebar-block">
              <h3 class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Prefer email?</h3>
              <a href="mailto:hello@conduit.studio" class="font-display text-xl hover:text-[var(--muted-foreground)] transition-colors duration-300 email-link">hello@conduit.studio</a>
            </div>
            <div class="sidebar-block">
              <h3 class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Offices</h3>
              <div class="space-y-4">
                <div class="office-card">
                  <div class="office-dot"></div>
                  <p class="font-body text-sm font-medium">Amsterdam</p>
                  <p class="font-body text-sm text-[var(--muted-foreground)]">Prinsengracht 263<br />1016 GV Amsterdam</p>
                </div>
                <div class="office-card">
                  <div class="office-dot"></div>
                  <p class="font-body text-sm font-medium">Portland</p>
                  <p class="font-body text-sm text-[var(--muted-foreground)]">820 NW 12th Ave<br />Portland, OR 97209</p>
                </div>
                <div class="office-card">
                  <div class="office-dot"></div>
                  <p class="font-body text-sm font-medium">Lagos</p>
                  <p class="font-body text-sm text-[var(--muted-foreground)]">14 Adeola Odeku Street<br />Victoria Island, Lagos</p>
                </div>
              </div>
            </div>
            <div class="sidebar-block">
              <h3 class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Follow Us</h3>
              <div class="flex flex-col gap-2">
                <a href="#" class="font-body text-sm hover:text-[var(--muted-foreground)] hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--foreground)]"></span>Twitter / X
                </a>
                <a href="#" class="font-body text-sm hover:text-[var(--muted-foreground)] hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--foreground)]"></span>LinkedIn
                </a>
                <a href="#" class="font-body text-sm hover:text-[var(--muted-foreground)] hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--foreground)]"></span>Dribbble
                </a>
                <a href="#" class="font-body text-sm hover:text-[var(--muted-foreground)] hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--foreground)]"></span>GitHub
                </a>
              </div>
            </div>
            <div class="bg-[var(--secondary)] rounded-xl p-6 border border-[var(--border)] guarantee-card">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-2 h-2 rounded-full bg-green-500 pulse-dot"></div>
                <h3 class="font-display text-lg">Quick response guarantee</h3>
              </div>
              <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">We respond to every inquiry within 24 hours. Real humans, not auto-replies. Usually we'll set up a call within 48 hours.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="px-6 md:px-12 lg:px-20 py-24 border-t border-[var(--border)] reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <div class="reveal-item" style="animation-delay: 0.1s">
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-4">Common Questions</p>
            <h2 class="font-display text-4xl md:text-5xl tracking-tight">Before you<br /><em class="italic">reach out.</em></h2>
          </div>
          <div class="space-y-0 reveal-item" style="animation-delay: 0.2s">
            <div class="faq-item border-b border-[var(--border)] py-6">
              <h4 class="font-body text-sm font-medium mb-2">How long does a typical project take?</h4>
              <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Focused sprints run 4–6 weeks. Full builds typically span 3–6 months. We'll give you an honest timeline in our first conversation.</p>
            </div>
            <div class="faq-item border-b border-[var(--border)] py-6">
              <h4 class="font-body text-sm font-medium mb-2">Do you work with startups or only established companies?</h4>
              <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Both. We care about the problem being solved, not the size of the company. Some of our best work has been with early-stage teams.</p>
            </div>
            <div class="faq-item border-b border-[var(--border)] py-6">
              <h4 class="font-body text-sm font-medium mb-2">What if we're not sure what we need?</h4>
              <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">That's perfectly fine. Our discovery process is designed to help you figure that out together. Start with a conversation — clarity follows.</p>
            </div>
            <div class="faq-item border-b border-[var(--border)] py-6">
              <h4 class="font-body text-sm font-medium mb-2">Can you work with our existing tech stack?</h4>
              <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed">Yes. We're framework-agnostic and adapt to your existing infrastructure. We'll recommend changes only when they genuinely serve your users.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="px-6 md:px-12 lg:px-20 py-12 border-t border-[var(--border)]">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
          <div>
            <a href="/1" class="font-display text-lg hover:opacity-70 transition-opacity duration-300">Conduit</a>
            <p class="font-body text-sm text-[var(--muted-foreground)] mt-1">Bridging human connection & technology.</p>
          </div>
          <div class="flex flex-wrap gap-6">
            <a href="/2" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Services</a>
            <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
            <a href="/4" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Work</a>
            <a href="/5" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Contact</a>
          </div>
          <p class="font-body text-xs text-[var(--muted-foreground)]">© 2026 Conduit. All rights reserved.</p>
        </div>
      </footer>

    </LayoutMain>
  </LayoutBody>
</Layout>

<style is:global>
  :root {
    --radius: 0.625rem;
    --background: oklch(0.975 0.006 90);
    --foreground: oklch(0.18 0.01 60);
    --card: oklch(1 0 0);
    --card-foreground: oklch(0.18 0.01 60);
    --popover: oklch(1 0 0);
    --popover-foreground: oklch(0.18 0.01 60);
    --primary: oklch(0.18 0.01 60);
    --primary-foreground: oklch(0.975 0.006 90);
    --secondary: oklch(0.94 0.01 85);
    --secondary-foreground: oklch(0.18 0.01 60);
    --muted: oklch(0.94 0.01 85);
    --muted-foreground: oklch(0.50 0.015 60);
    --accent: oklch(0.94 0.01 85);
    --accent-foreground: oklch(0.18 0.01 60);
    --destructive: oklch(0.577 0.245 27.325);
    --destructive-foreground: oklch(0.985 0 0);
    --border: oklch(0.18 0.01 60 / 10%);
    --input: oklch(0.18 0.01 60 / 12%);
    --ring: oklch(0.708 0 0);
  }

  .font-display {
    font-family: 'Gambetta', serif;
  }
  .font-body {
    font-family: 'Manrope', sans-serif;
  }

  /* === NAV BLUR === */
  .nav-blur {
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    background: oklch(0.975 0.006 90 / 75%);
  }

  /* === WARM AMBIENT === */
  .warm-ambient {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(ellipse, oklch(0.85 0.05 80 / 20%) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: ambient-float 14s ease-in-out infinite alternate;
  }

  @keyframes ambient-float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-20px, 15px) scale(1.05); }
  }

  /* === HERO ANIMATIONS === */
  .line-reveal {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
    animation: line-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes line-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* === TYPING CURSOR === */
  .typing-cursor {
    position: relative;
  }
  .typing-cursor::after {
    content: '';
    position: absolute;
    right: -8px;
    top: 10%;
    width: 3px;
    height: 70%;
    background: var(--foreground);
    animation: cursor-blink 1.2s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* === SCROLL REVEAL === */
  .reveal-section .reveal-item {
    opacity: 0;
    transform: translateY(24px);
  }
  .reveal-section.is-visible .reveal-item {
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* === CONTACT INPUT === */
  .contact-input {
    font-family: 'Manrope', sans-serif;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--border);
    padding-bottom: 0.75rem;
    color: var(--foreground);
    font-size: 0.875rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .contact-input::placeholder {
    color: oklch(0.50 0.015 60 / 40%);
  }
  .contact-input:focus {
    outline: none;
    border-color: var(--foreground);
    box-shadow: 0 2px 0 var(--foreground);
  }

  /* === CONTACT TEXTAREA === */
  .contact-textarea {
    font-family: 'Manrope', sans-serif;
    width: 100%;
    background: transparent;
    border: 1.5px solid var(--border);
    border-radius: 0.75rem;
    padding: 1rem;
    color: var(--foreground);
    font-size: 0.875rem;
    resize: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .contact-textarea::placeholder {
    color: oklch(0.50 0.015 60 / 40%);
  }
  .contact-textarea:focus {
    outline: none;
    border-color: var(--foreground);
    box-shadow: 0 0 0 3px oklch(0.18 0.01 60 / 6%);
  }

  /* === PILL BUTTONS === */
  .pill-button {
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    border: 1.5px solid var(--border);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pill-button:hover {
    background: var(--accent);
    border-color: oklch(0.18 0.01 60 / 20%);
    transform: translateY(-1px);
  }
  .pill-button:focus,
  .pill-button.active {
    background: var(--foreground);
    color: var(--background);
    border-color: var(--foreground);
    transform: translateY(-1px);
  }

  /* === SUBMIT BUTTON === */
  .submit-btn {
    position: relative;
    overflow: hidden;
  }
  .submit-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 40%, oklch(1 0 0 / 10%) 50%, transparent 60%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }
  .submit-btn:hover::after {
    transform: translateX(100%);
  }

  /* === OFFICE CARD === */
  .office-card {
    position: relative;
    padding-left: 16px;
    transition: transform 0.3s ease;
  }
  .office-card:hover {
    transform: translateX(4px);
  }
  .office-dot {
    position: absolute;
    left: 0;
    top: 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--foreground);
    opacity: 0.2;
    transition: opacity 0.3s ease;
  }
  .office-card:hover .office-dot {
    opacity: 0.5;
  }

  /* === EMAIL LINK === */
  .email-link {
    position: relative;
  }
  .email-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--foreground);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .email-link:hover::after {
    width: 100%;
  }

  /* === PULSE DOT === */
  .pulse-dot {
    animation: pulse-green 2s ease-in-out infinite;
  }

  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 0 0 0 oklch(0.72 0.19 142 / 40%); }
    50% { box-shadow: 0 0 0 6px oklch(0.72 0.19 142 / 0%); }
  }

  /* === GUARANTEE CARD === */
  .guarantee-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .guarantee-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(0 0 0 / 6%);
  }

  /* === FAQ ITEMS === */
  .faq-item {
    transition: background 0.3s ease;
    padding-left: 0;
    border-radius: 0;
  }
  .faq-item:hover {
    padding-left: 8px;
  }
  .faq-item h4 {
    transition: transform 0.3s ease;
  }
  .faq-item:hover h4 {
    transform: translateX(2px);
  }
</style>

<script>
  // Scroll reveal
  const sections = document.querySelectorAll('.reveal-section');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.15 });
  sections.forEach(section => observer.observe(section));

  // Pill button toggle
  document.querySelectorAll('.pill-button').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('active');
    });
  });
</script>
