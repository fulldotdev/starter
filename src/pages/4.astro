---
import "@/styles/global.css"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
---

<Layout>
  <LayoutHead title="Work — Conduit" description="Selected projects from our portfolio. Each one started with a human problem and ended with a meaningful digital solution.">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=General+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet" />
  </LayoutHead>
  <LayoutBody>
    <LayoutMain class="relative">

      <!-- Nav -->
      <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-5 md:px-12 lg:px-20 nav-blur">
        <a href="/1" class="font-display text-xl font-medium">Conduit</a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/2" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Services</a>
          <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
          <a href="/4" class="font-body text-sm font-medium text-[var(--foreground)]">Work</a>
          <a href="/5" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Contact</a>
        </div>
        <a href="/5" class="font-body text-sm border border-[var(--border)] px-4 py-2 rounded-full hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-all duration-300">Let's Talk</a>
      </nav>

      <!-- Hero -->
      <section class="px-6 md:px-12 lg:px-20 pt-32 pb-20 relative overflow-hidden">
        <!-- Background oversized text -->
        <div class="absolute top-20 right-0 font-display text-[15rem] md:text-[22rem] font-bold leading-none text-[var(--foreground)]/[0.025] pointer-events-none select-none tracking-tighter bg-text">WORK</div>
        <div class="max-w-5xl relative">
          <p class="font-body text-sm uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-6 fade-in" style="animation-delay: 0.1s">Our Work</p>
          <h1 class="font-display text-5xl md:text-6xl lg:text-8xl leading-[0.95] font-medium tracking-tight mb-8">
            <span class="line-reveal" style="animation-delay: 0.15s">Case</span><br />
            <span class="line-reveal" style="animation-delay: 0.3s">Studies</span>
          </h1>
          <p class="font-body text-lg text-[var(--muted-foreground)] max-w-xl leading-relaxed fade-in" style="animation-delay: 0.5s">
            Every project here solved a real problem for real people. These aren't just pixels and code — they're stories of connection.
          </p>
        </div>
      </section>

      <!-- Project 1 — Full Width -->
      <section class="px-6 md:px-12 lg:px-20 py-12 border-t border-[var(--border)] reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-8 reveal-item" style="animation-delay: 0.1s">
            <a href="#" class="block group">
              <div class="aspect-[16/10] bg-[var(--muted)] rounded-lg relative overflow-hidden case-image">
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-600"></div>
                <div class="absolute bottom-6 left-6 right-6 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-100">
                  <span class="font-body text-sm text-white/90 bg-[var(--foreground)]/60 backdrop-blur-sm px-4 py-2 rounded-full">View Full Case Study →</span>
                </div>
                <!-- Project number watermark -->
                <div class="absolute top-4 left-6 font-display text-7xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">01</div>
              </div>
            </a>
          </div>
          <div class="lg:col-span-4 lg:pt-4 reveal-item" style="animation-delay: 0.25s">
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-3">Healthcare · 2025</p>
            <h2 class="font-display text-3xl md:text-4xl font-medium tracking-tight mb-4">MedConnect</h2>
            <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">A patient portal that replaced confusing clinical interfaces with warm, intuitive flows. Patients actually enjoy managing their health now.</p>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div class="metric">
                <p class="font-display text-2xl font-medium">3.2x</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">User Engagement</p>
              </div>
              <div class="metric">
                <p class="font-display text-2xl font-medium">68%</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Faster Onboarding</p>
              </div>
              <div class="metric">
                <p class="font-display text-2xl font-medium">4.9★</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">App Store Rating</p>
              </div>
            </div>
            <a href="#" class="font-body text-sm underline underline-offset-4 decoration-[var(--border)] hover:decoration-[var(--foreground)] transition-all duration-300">Read Case Study →</a>
          </div>
        </div>
      </section>

      <!-- Project 2 & 3 — Side by Side -->
      <section class="px-6 md:px-12 lg:px-20 py-12 reveal-section">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <a href="#" class="group block reveal-item" style="animation-delay: 0.1s">
            <div class="aspect-[4/3] bg-[var(--muted)] rounded-lg mb-6 relative overflow-hidden case-image">
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
              <div class="absolute top-4 left-6 font-display text-6xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">02</div>
            </div>
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-2">EdTech · 2024</p>
            <h3 class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-3 group-hover:translate-x-1 transition-transform duration-300">Luminary</h3>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed mb-4">An adaptive learning platform that feels like a conversation with a great teacher. Personalized paths, zero overwhelm.</p>
            <div class="flex gap-6 mb-4">
              <div class="metric">
                <p class="font-display text-xl font-medium">250K</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Active Learners</p>
              </div>
              <div class="metric">
                <p class="font-display text-xl font-medium">91%</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Completion Rate</p>
              </div>
            </div>
          </a>
          <a href="#" class="group block reveal-item" style="animation-delay: 0.25s">
            <div class="aspect-[4/3] bg-[var(--muted)] rounded-lg mb-6 relative overflow-hidden case-image">
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
              <div class="absolute top-4 left-6 font-display text-6xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">03</div>
            </div>
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-2">Non-Profit · 2024</p>
            <h3 class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-3 group-hover:translate-x-1 transition-transform duration-300">Haven</h3>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed mb-4">A crisis support platform connecting vulnerable people with counselors in real time. Designed for trust at first glance.</p>
            <div class="flex gap-6 mb-4">
              <div class="metric">
                <p class="font-display text-xl font-medium">12min</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Avg. Response Time</p>
              </div>
              <div class="metric">
                <p class="font-display text-xl font-medium">40K</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">People Helped</p>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- Project 4 — Full Width Reversed -->
      <section class="px-6 md:px-12 lg:px-20 py-12 border-t border-[var(--border)] reveal-section">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 lg:pt-4 lg:order-1 reveal-item" style="animation-delay: 0.1s">
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-3">FinTech · 2023</p>
            <h2 class="font-display text-3xl md:text-4xl font-medium tracking-tight mb-4">Ember</h2>
            <p class="font-body text-[var(--muted-foreground)] leading-relaxed mb-6">A personal finance app for Gen Z that ditches intimidating charts for gentle, encouraging nudges. Money management that feels like self-care.</p>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div class="metric">
                <p class="font-display text-2xl font-medium">800K</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Downloads</p>
              </div>
              <div class="metric">
                <p class="font-display text-2xl font-medium">78%</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">30-Day Retention</p>
              </div>
              <div class="metric">
                <p class="font-display text-2xl font-medium">#3</p>
                <p class="font-body text-xs text-[var(--muted-foreground)]">Finance Category</p>
              </div>
            </div>
            <a href="#" class="font-body text-sm underline underline-offset-4 decoration-[var(--border)] hover:decoration-[var(--foreground)] transition-all duration-300">Read Case Study →</a>
          </div>
          <div class="lg:col-span-8 lg:order-2 reveal-item" style="animation-delay: 0.2s">
            <a href="#" class="block group">
              <div class="aspect-[16/10] bg-[var(--muted)] rounded-lg relative overflow-hidden case-image">
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
                <div class="absolute top-4 left-6 font-display text-7xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">04</div>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- Project 5 & 6 — Side by Side -->
      <section class="px-6 md:px-12 lg:px-20 py-12 reveal-section">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <a href="#" class="group block reveal-item" style="animation-delay: 0.1s">
            <div class="aspect-[4/3] bg-[var(--muted)] rounded-lg mb-6 relative overflow-hidden case-image">
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
              <div class="absolute top-4 left-6 font-display text-6xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">05</div>
            </div>
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-2">E-Commerce · 2023</p>
            <h3 class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-3 group-hover:translate-x-1 transition-transform duration-300">Terroir</h3>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed mb-4">A farm-to-table marketplace that makes buying directly from growers feel as personal as visiting a farmer's market.</p>
          </a>
          <a href="#" class="group block reveal-item" style="animation-delay: 0.25s">
            <div class="aspect-[4/3] bg-[var(--muted)] rounded-lg mb-6 relative overflow-hidden case-image">
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--foreground)]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
              <div class="absolute top-4 left-6 font-display text-6xl font-bold text-[var(--foreground)]/[0.05] pointer-events-none">06</div>
            </div>
            <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] mb-2">SaaS · 2022</p>
            <h3 class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-3 group-hover:translate-x-1 transition-transform duration-300">ThreadPull</h3>
            <p class="font-body text-sm text-[var(--muted-foreground)] leading-relaxed mb-4">A team collaboration tool that replaced notification overload with calm, intentional communication. Meetings dropped 60%.</p>
          </a>
        </div>
      </section>

      <!-- Client Logos -->
      <section class="px-6 md:px-12 lg:px-20 py-20 border-t border-[var(--border)] reveal-section">
        <p class="font-body text-xs uppercase tracking-[0.2em] text-[var(--muted-foreground)] text-center mb-12 reveal-item" style="animation-delay: 0.1s">Trusted By</p>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center justify-items-center logo-strip">
          <div class="h-8 w-24 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500"></div>
          <div class="h-8 w-20 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500"></div>
          <div class="h-8 w-28 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500"></div>
          <div class="h-8 w-22 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500"></div>
          <div class="h-8 w-24 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500 hidden lg:block"></div>
          <div class="h-8 w-20 bg-[var(--foreground)] rounded opacity-10 hover:opacity-25 transition-opacity duration-500 hidden lg:block"></div>
        </div>
      </section>

      <!-- CTA -->
      <section class="px-6 md:px-12 lg:px-20 py-24 bg-[var(--foreground)] text-[var(--background)] relative overflow-hidden reveal-section">
        <div class="absolute inset-0 work-cta-pattern"></div>
        <div class="max-w-3xl mx-auto text-center relative">
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight mb-6 reveal-item" style="animation-delay: 0.1s">Your project<br />could be next.</h2>
          <p class="font-body text-lg opacity-70 mb-10 max-w-lg mx-auto reveal-item" style="animation-delay: 0.2s">Let's talk about the problem you're solving and the people you're solving it for.</p>
          <div class="reveal-item" style="animation-delay: 0.3s">
            <a href="/5" class="font-body text-sm bg-[var(--background)] text-[var(--foreground)] px-8 py-3.5 rounded-full inline-block hover:scale-[1.03] hover:shadow-xl active:scale-[0.98] transition-all duration-300">Start a Conversation</a>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="px-6 md:px-12 lg:px-20 py-12 border-t border-[var(--border)]">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
          <div>
            <a href="/1" class="font-display text-lg font-medium hover:opacity-70 transition-opacity duration-300">Conduit</a>
            <p class="font-body text-sm text-[var(--muted-foreground)] mt-1">Bridging human connection & technology.</p>
          </div>
          <div class="flex flex-wrap gap-6">
            <a href="/2" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Services</a>
            <a href="/3" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">About</a>
            <a href="/4" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Work</a>
            <a href="/5" class="font-body text-sm text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors duration-300">Contact</a>
          </div>
          <p class="font-body text-xs text-[var(--muted-foreground)]">© 2026 Conduit. All rights reserved.</p>
        </div>
      </footer>

    </LayoutMain>
  </LayoutBody>
</Layout>

<style is:global>
  :root {
    --radius: 0.625rem;
    --background: oklch(0.99 0 0);
    --foreground: oklch(0.12 0 0);
    --card: oklch(1 0 0);
    --card-foreground: oklch(0.12 0 0);
    --popover: oklch(1 0 0);
    --popover-foreground: oklch(0.12 0 0);
    --primary: oklch(0.12 0 0);
    --primary-foreground: oklch(0.99 0 0);
    --secondary: oklch(0.96 0 0);
    --secondary-foreground: oklch(0.12 0 0);
    --muted: oklch(0.94 0 0);
    --muted-foreground: oklch(0.48 0 0);
    --accent: oklch(0.94 0 0);
    --accent-foreground: oklch(0.12 0 0);
    --destructive: oklch(0.577 0.245 27.325);
    --destructive-foreground: oklch(0.985 0 0);
    --border: oklch(0.12 0 0 / 8%);
    --input: oklch(0.12 0 0 / 10%);
    --ring: oklch(0.708 0 0);
  }

  .font-display {
    font-family: 'Clash Display', sans-serif;
  }
  .font-body {
    font-family: 'General Sans', sans-serif;
  }

  /* === NAV BLUR === */
  .nav-blur {
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    background: oklch(0.99 0 0 / 80%);
  }

  /* === HERO ANIMATIONS === */
  .line-reveal {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
    animation: line-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes line-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* === BACKGROUND TEXT === */
  .bg-text {
    animation: bg-text-drift 20s ease-in-out infinite alternate;
  }

  @keyframes bg-text-drift {
    0% { transform: translateX(0); }
    100% { transform: translateX(-30px); }
  }

  /* === SCROLL REVEAL === */
  .reveal-section .reveal-item {
    opacity: 0;
    transform: translateY(24px);
  }
  .reveal-section.is-visible .reveal-item {
    animation: line-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* === CASE STUDY IMAGES === */
  .case-image {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }
  .group:hover .case-image {
    transform: scale(1.02);
    box-shadow: 0 24px 64px oklch(0 0 0 / 12%);
  }

  /* === METRICS === */
  .metric {
    position: relative;
  }
  .metric::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 16px;
    height: 2px;
    background: var(--foreground);
    opacity: 0.15;
  }

  /* === WORK CTA PATTERN === */
  .work-cta-pattern {
    background-image:
      linear-gradient(45deg, oklch(1 0 0 / 2%) 25%, transparent 25%),
      linear-gradient(-45deg, oklch(1 0 0 / 2%) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, oklch(1 0 0 / 2%) 75%),
      linear-gradient(-45deg, transparent 75%, oklch(1 0 0 / 2%) 75%);
    background-size: 40px 40px;
    background-position: 0 0, 0 20px, 20px -20px, -20px 0px;
  }
</style>

<script>
  const sections = document.querySelectorAll('.reveal-section');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.12 });
  sections.forEach(section => observer.observe(section));
</script>
