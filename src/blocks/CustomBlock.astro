---
import Section from 'fulldev-ui/components/Section.astro'

const { ...rest } = Astro.props
---

{
  /*
    Example of a custom block using the Section component from fulldev-ui.

    Since the name is CustomBlock, the name of your bookshop block should also be CustomBlock.

    If this were to be named Hero, which already exists in fulldev-ui,
    it would overwrite the block from fulldev-ui.
  */
}

<Section
  class:list="reviews"
  structure="masonry"
  align="center"
  panel
  {...rest}
/>

{
  /*
      The classlist used here is set to "reviews", which corresponds to the class for the reviews block from fulldev-ui.
      This provides a default styling for the CustomBlock component.

      However, you have the flexibility to customize this classlist:

      1. You can overwrite it with any other predefined classlist from fulldev-ui,
         which allows you to adopt styles from other existing components.

      2. Alternatively, you can create your own custom classlist by defining new styles
         in a separate CSS file, such as `src/css/custom.css`.

      This approach gives you the option to either leverage existing styles or create
      completely custom designs for your CustomBlock component.
    */
}
