---
import type { ComponentProps } from 'astro/types'
import { Button, Column, Heading, Image, Row, Section, Text } from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  heading?: string
  paragraph?: string
  text?: string
  image?: string
  buttons?: ComponentProps<typeof Button>[]
}

const { heading, text, buttons, image, ...rest } = Astro.props
---

<Section
  align="center"
  {...rest}
>
  <Column align="center">
    <Heading
      level={1}
      size="lg"
      html={heading}
    />
    <Text
      html={text}
      style={{ textAlign: 'center' }}
    />
    <Row>
      {buttons?.map((button) => <Button {...button} />)}
    </Row>
  </Column>
  <Image src={image} />
</Section>
