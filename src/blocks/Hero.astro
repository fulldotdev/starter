---
import type { ComponentProps } from 'astro/types'
import {
  Button,
  Column,
  Heading,
  Image,
  Paragraph,
  Row,
  Section,
} from 'fulldev-ui'

interface Props extends ComponentProps<typeof Section> {
  image?: ComponentProps<typeof Image>['src']
  heading?: ComponentProps<typeof Heading>['html']
  paragraph?: ComponentProps<typeof Paragraph>['html']
  buttons?: ComponentProps<typeof Button>[]
}

const { image, heading, paragraph, buttons, size, ...rest } = Astro.props
---

<div
  class={'hero ' + rest.class}
  {...rest}
>
  <Section
    structure="column"
    {size}
  >
    <Column>
      <Heading
        level={1}
        html={heading}
      />
      <Paragraph html={paragraph} />
    </Column>
    <Row>
      {buttons?.map((button) => <Button {...button} />)}
    </Row>
  </Section>
  <Image
    position="background"
    src={image}
  />
</div>

<style is:global lang="scss">
  .hero {
    display: flex;
    position: relative;
    align-items: end;

    .full.section {
      gap: var(--space-4);
      backdrop-filter: blur(6px);
      margin-top: calc(var(--space-6) * 2) !important;
      background: hsla(0, 0%, 7%, 0.7);
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);

      .full.heading span {
        color: var(--primary-background);
      }
    }
  }
</style>
